# ───── BYOK #1 · 主力槽位 ─────
# OpenAI 兼容端点（官方 / 中转 / 本地 vLLM 均可）
BYOK1_OPENAI_API_HOST=api.example.com
BYOK1_OPENAI_API_KEY=sk-your-key-here
BYOK1_OPENAI_API_PATH=/v1/chat/completions
# Anthropic 兼容端点（可选，填了 anthropic 协议走这里）
BYOK1_ANTHROPIC_API_HOST=api.example.com
BYOK1_ANTHROPIC_API_KEY=sk-your-key-here
BYOK1_ANTHROPIC_API_PATH=/v1/messages
# 实际模型名（Devin 里选官方 uid 如 swe-1-6 时路由到这里）
BYOK1_MODEL=your-model-name
# 协议: openai | anthropo | gemini（留空按模型名前缀自动判别）
BYOK1_PROTOCOL=openai

# ───── BYOK #2-4 · 备用槽位（Devin 模型名 swe-1-6-medium/swe-1-7-max/swe-1-7-fast 对应）─────
# BYOK2_OPENAI_API_HOST=...
# BYOK2_OPENAI_API_KEY=...
# BYOK2_MODEL=...
# BYOK2_PROTOCOL=openai

# ───── 通用 ─────
HYBRID_PORT=3006
DEFAULT_MODEL=your-model-name
MAX_TOKENS=64000
COMPLETION_TIMEOUT_MS=12000

# MITM 证书目录（首次运行 node setup-cert.mjs 会生成到 ~/.devin-byok/certs）
# MITM_CERTS_DIR=C:/Users/<you>/.devin-byok/certs
